# ==============================================================================
# FloodLens — Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# Data files & directories (NEVER commit raw or large geographic datasets)
# ------------------------------------------------------------------------------
data/raw/*/*
!data/raw/*/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Ignore common GIS and spatial data formats anywhere in the repo
*.shp
*.shx
*.dbf
*.prj
*.cpg
*.qpj
*.sbn
*.sbx
*.geojson
*.gpkg
*.kml
*.kmz
*.tif
*.tiff
*.dem
*.asc
*.nc
*.h5
*.hdf
*.tar
*.gz
*.zip
*.7z
*.rar
*.parquet
*.feather

# Keep metadata CSV files tracked
!data/metadata/*.csv

# ------------------------------------------------------------------------------
# Python & Environment
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/
*-checkpoint.ipynb

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
*.py,cover

# ------------------------------------------------------------------------------
# Frontend & Node.js
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------------------------------------------
# Operating System & IDEs
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*~
